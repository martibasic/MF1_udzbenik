        "\n",
        "$$\n",
        "T = \\frac{8292 \\cdot 0{,}733 + 13026 \\cdot 0{,}467}{1{,}10} = 11057\\ \\text{N}\n",
        "$$\n",
        "\n",
        "pa je potrebna sila spojnice\n",
        "\n",
        "$$\n",
        "T \\approx 11{,}06\\ \\text{kN}\n",
        "$$\n",
        "\n",
