        "    [cx, cx, cx, cx], fc='#AED6F1', ec='none', alpha=0.0)\n",
        "# Fluid pod ponton\n",
        "ax.fill([1.0, 1.0 + B_p, 1.0 + B_p, 1.0],\n",
        "    [cx - 0.2, cx - 0.2, cx - 0.2, cx - 0.2], fc='none')\n",
        "\n",
        "# Ponton (nagnuta daska)\n",
        "ax.fill([1.0, 1.0 + B_p, 1.0 + B_p, 1.0],\n",
        "    [sf_L, sf_R, sf_R - 0.2, sf_L - 0.2],\n",
        "    fc='#5D6D7E', ec='#2C3E50', lw=2.0)\n",
