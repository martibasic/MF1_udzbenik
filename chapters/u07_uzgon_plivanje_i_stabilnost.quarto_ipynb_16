        "#| fig-align: center\n",
        "#| out-width: 50%\n",
        "\n",
        "import matplotlib.pyplot as plt\n",
        "import numpy as np\n",
        "\n",
        "fig, ax = plt.subplots(figsize=(5, 4))\n",
        "ax.set_xlim(0, 8); ax.set_ylim(0, 7)\n",
        "ax.axis('off')\n",
        "\n",
        "# Parametri (skala: 1m = 5 plot jed.)\n",
